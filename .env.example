# Copy to .env (never commit .env) and fill in your key.
# Free key: https://restcountries.com -> create an account -> API Keys.
# In the key settings, add your allowed origins: localhost and your deployed domain.
# Note: VITE_ variables are embedded in the browser bundle, so this key is visible to users.
VITE_RESTCOUNTRIES_API_KEY=

# Optional: partner search widgets on a trip's Bookings tab (e.g. Travelpayouts).
# In the partner dashboard, create a widget and copy the https URL from the src="..." of its
# <script> embed code. It contains your public affiliate id (not a secret).
# Optional placeholders, filled in per trip: {query} {checkin} {checkout} {currency}
# Leave empty to show only the external search links.
VITE_PARTNER_WIDGET_HOTEL=
VITE_PARTNER_WIDGET_FLIGHT=
VITE_PARTNER_WIDGET_ACTIVITY=
